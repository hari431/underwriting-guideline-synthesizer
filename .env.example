# RateCraft local model configuration.
# Copy to .env (gitignored, never commit) and fill in your Meta API key:
#   Copy-Item .env.example .env
# The server loads .env automatically on startup (src/dotenv.js); values
# already set in the shell environment take precedence (never overridden).
#
# Live extraction needs the flag + your key; URL/model fall back to the
# Meta hackathon defaults below when unset (see src/extract.js):
# - UNDERWRITEIQ_ENABLE_MODEL=1 explicitly opts in to Meta API calls.
# - UNDERWRITEIQ_API_KEY sent as: Authorization: Bearer <key> (keep blank here).
# - UNDERWRITEIQ_MODEL_URL is the FULL chat-completions endpoint URL (POST),
#   not the base URL — the app posts to it directly with no path joining.
# - UNDERWRITEIQ_MODEL_NAME model identifier sent as the "model" field.
UNDERWRITEIQ_ENABLE_MODEL=1
UNDERWRITEIQ_API_KEY=
UNDERWRITEIQ_MODEL_URL=https://api.meta.ai/v1/chat/completions
UNDERWRITEIQ_MODEL_NAME=muse-spark-1.3
